# Byte-compiled files
__pycache__/
*.py[cod]

# Packaging artefacts
build/
dist/
*.egg-info/

# Virtual environment (uv creates .venv in the project root by default)
.venv/

# Test and coverage artefacts
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Tool caches
.mypy_cache/
.ruff_cache/

# Editors and operating system
.idea/
.vscode/
.DS_Store

# Agent tooling, kept local for now. Revisit if the seed should ship it.
.claude/

# Local environment overrides. Never commit real secrets; commit the example.
.env
.env.*
!.env.example

# NOTE: uv.lock is deliberately NOT ignored. See ADR-0005.
